; Engine configuration file.
; Persian Classic Board Games: Mench (Ludo) & Takhte Nard (Backgammon) — Mobile Portrait 3D

config_version=5

[application]

config/name="منچ و تخته نرد — کلاسیک پارسی"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/app_icon.png"
boot_splash/bg_color=Color(0.08, 0.045, 0.032, 1)

[autoload]

GameState="*res://scripts/autoload/GameState.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
NetworkManager="*res://scripts/autoload/NetworkManager.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=500
window/size/window_height_override=890
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[internationalization]

rendering/force_right_to_left_layout_direction=false

[rendering]

renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=4096
